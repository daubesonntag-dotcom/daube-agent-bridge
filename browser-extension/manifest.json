{
  "manifest_version": 3,
  "name": "D'AUBE // BRIDGE²",
  "version": "0.1.3",
  "description": "D'AUBE browser execution connector and portable AI skill control panel.",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "action": {
    "default_title": "Open D'AUBE // BRIDGE²"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
