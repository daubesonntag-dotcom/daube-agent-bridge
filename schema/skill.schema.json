{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daubesonntag.com/bridge/skill.schema.json",
  "$defs": {
    "ParameterContract": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "const": "object",
          "default": "object",
          "title": "Type",
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "title": "Properties"
        },
        "required": {
          "items": {
            "type": "string"
          },
          "title": "Required",
          "type": "array"
        }
      },
      "title": "ParameterContract",
      "type": "object"
    },
    "ToolContract": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/ParameterContract"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "ToolContract",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Canonical portable skill contract used by runtime validation and schema generation.",
  "properties": {
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "description": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ToolContract"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Tools",
      "type": "array"
    },
    "instructions": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "title": "Instructions",
      "type": "array"
    },
    "required_capabilities": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:/-]+$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Required Capabilities",
      "type": "array"
    }
  },
  "required": [
    "name",
    "version",
    "description",
    "tools"
  ],
  "title": "D'AUBE BRIDGE² Skill",
  "type": "object"
}
